# Copy to .env and adjust as needed. .env is gitignored — never commit real secrets.

# --- Local infrastructure (docker-compose) ---
POSTGRES_USER=mara
POSTGRES_PASSWORD=mara_dev_password
POSTGRES_DB=mara_mortgage
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- apps/api ---
# Prisma connection string (matches the docker-compose defaults above)
DATABASE_URL=postgresql://mara:mara_dev_password@localhost:5432/mara_mortgage
REDIS_URL=redis://localhost:6379
API_PORT=3001

# JWT secrets — generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_dev_only
JWT_REFRESH_SECRET=replace_me_dev_only_2

# Document storage. Local disk by default; setting S3_BUCKET (plus the
# credentials below) switches to any S3-compatible bucket — Cloudflare R2,
# AWS S3, MinIO — with no code change. See DEPLOYMENT.md "Durable document
# storage".
FILE_STORAGE_DIR=storage
# S3_BUCKET=
# S3_ENDPOINT=            # R2: https://<account-id>.r2.cloudflarestorage.com (omit for AWS S3)
# S3_REGION=auto          # R2 uses "auto"; AWS uses a real region
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Arive borrower portal (M19 handoff adapter) ---
# Where "Start my application" sends borrowers. Defaults to Mara's
# LO-specific Arive 1003 registration link (company NMLS subdomain +
# her individual NMLS path, so registrations land in her pipeline);
# override only if the portal domain or her link changes.
ARIVE_PORTAL_URL=https://1806779.my1003app.com/1925279/register

# Production CORS allowlist: comma-separated origins of the deployed borrower
# web app + admin site (see DEPLOYMENT.md). Ignored outside NODE_ENV=production.
WEB_ORIGINS=

# Optional seed-time admin bootstrap (production first-run — see DEPLOYMENT.md).
# When both are set, `pnpm prisma:seed` creates this ADMIN account if absent.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Error tracking (Sentry) ---
# Leave empty to run without Sentry (local dev default). Paste the DSNs from
# your Sentry projects (one API/Node project, one React Native project).
# Native builds set SENTRY_DISABLE_AUTO_UPLOAD=true in eas.json until a real
# Sentry org/project + SENTRY_AUTH_TOKEN exist — remove it then so release
# builds upload source maps.
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# --- Product analytics (PostHog) ---
# Leave empty to run without analytics events (local dev default). The admin
# Analytics page works either way — it reads first-party numbers from the API.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
