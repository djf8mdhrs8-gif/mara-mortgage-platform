{
  "name": "@mara/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo \"native builds run via EAS, not turbo\" && exit 0",
    "eas-build-post-install": "pnpm --filter @mara/mortgage-calc build && pnpm --filter @mara/shared-types build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --max-warnings=0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@mara/mortgage-calc": "workspace:*",
    "@mara/shared-types": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "openapi-fetch": "^0.17.0",
    "posthog-react-native": "^4.61.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "^6.0.3"
  }
}
